  {
    "id": "fn_device_timeout",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Alerta de Queda de Sinal",
    "func": "const alertCard = {\n    level: 'CRÍTICO',\n    color: '#D63031',\n    title: 'PERDA DE COMUNICAÇÃO COM O VESTÍVEL!',\n    details: 'Nenhum sinal de telemetria recebido nos últimos 15 segundos. Verifique o paciente e a conexão Wi-Fi do ESP32.',\n    timestamp: new Date().toLocaleTimeString()\n};\n\nconst connStatus = {\n    payload: 'OFFLINE (DESCONECTADO)',\n    queue: '?',\n    device: 'ESP32-CARDIOIA-001',\n    uptime: 0,\n    color: '#D63031'\n};\n\nreturn [{ payload: alertCard }, { payload: connStatus }];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 280,
    "wires": [
      [
        "ui_alert_banner"
      ],
      [
        "ui_text_conn_info"
      ]
    ]
  },
  {
    "id": "fn_parse_status",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Trata LWT / Status",
    "func": "const statusData = msg.payload;\nconst isOffline = statusData.status === 'OFFLINE';\n\nconst connStatus = {\n    payload: isOffline ? 'OFFLINE (LWT RECEBIDO)' : 'ONLINE',\n    queue: 0,\n    device: statusData.device || 'ESP32-CARDIOIA-001',\n    uptime: 0,\n    color: isOffline ? '#D63031' : '#00B894'\n};\n\nlet alertCard = null;\nif (isOffline) {\n    alertCard = {\n        level: 'CRÍTICO',\n        color: '#D63031',\n        title: 'DISPOSITIVO OFFLINE (LAST WILL)',\n        details: statusData.reason || 'O dispositivo vestível desconectou abruptamente da nuvem HiveMQ.',\n        timestamp: new Date().toLocaleTimeString()\n    };\n}\n\nreturn [{ payload: connStatus }, alertCard ? { payload: alertCard } : null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 340,
    "wires": [
      [
        "ui_text_conn_info"
      ],
      [
        "ui_alert_banner"
      ]
    ]
  }
]
