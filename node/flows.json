  {
    "id": "fn_parse_telemetry",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Roteador de Dados",
    "func": "const payload = msg.payload;\n\n// 1. Frequencia Cardiaca\nconst msgBpm = {\n    payload: payload.vitals ? payload.vitals.heart_rate_bpm : 0,\n    topic: 'BPM'\n};\n\n// 2. Temperatura\nconst msgTemp = {\n    payload: payload.vitals ? parseFloat(payload.vitals.temperature_c) : 0,\n    topic: 'Temperatura'\n};\n\n// 3. Umidade\nconst msgHum = {\n    payload: payload.vitals ? parseFloat(payload.vitals.humidity_pct) : 0,\n    topic: 'Umidade'\n};\n\n// 4. Metadados de Conexao & Edge\nconst isSynced = payload.status && payload.status.is_synced_data;\nconst queueSize = payload.status ? payload.status.offline_queue_size : 0;\nconst connStatus = {\n    payload: `ONLINE ${isSynced ? '(DADOS RECUPERADOS)' : ''}`,\n    queue: queueSize,\n    device: payload.device_id || 'ESP32',\n    uptime: payload.uptime_s || 0,\n    color: isSynced ? '#F39C12' : '#00B894'\n};\n\nreturn [msgBpm, msgTemp, msgHum, { payload: connStatus }];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 180,
    "wires": [
      [
        "ui_gauge_bpm",
        "ui_chart_bpm"
      ],
      [
        "ui_gauge_temp"
      ],
      [
        "ui_gauge_hum"
      ],
      [
        "ui_text_conn_info"
      ]
    ]
  },
