  {
    "id": "ui_text_conn_info",
    "type": "ui_template",
    "z": "tab_cardioia",
    "group": "grp_connectivity",
    "name": "Card Conexão e Fila",
    "order": 1,
    "width": "6",
    "height": "4",
    "format": "<div style=\"padding: 10px; font-family: sans-serif;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n    <span style=\"font-size: 14px; color: #636e72;\">Estado da Comunicação:</span>\n    <span style=\"background-color: {{msg.payload.color || '#00B894'}}; color: white; padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 12px;\">\n      {{msg.payload.payload || 'ONLINE'}}\n    </span>\n  </div>\n  <hr style=\"border: none; border-top: 1px solid #dfe6e9; margin: 8px 0;\">\n  <div style=\"font-size: 13px; line-height: 1.8;\">\n    <div><b>Dispositivo:</b> {{msg.payload.device || 'ESP32-CARDIOIA-001'}}</div>\n    <div><b>Fila de Borda Offline:</b> <span style=\"color: #d63031; font-weight: bold;\">{{msg.payload.queue || 0}}</span> registros</div>\n    <div><b>Tempo Ativo (Uptime):</b> {{msg.payload.uptime || 0}} segundos</div>\n    <div><b>Protocolo:</b> MQTT (HiveMQ Cloud / TLS)</div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 680,
    "y": 360,
    "wires": [
      []
    ]
  },
  {
    "id": "fn_check_alerts",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Processador de Alertas",
    "func": "const payload = msg.payload;\nconst vitals = payload.vitals || {};\nconst bpm = vitals.heart_rate_bpm || 0;\nconst temp = parseFloat(vitals.temperature_c || 0);\n\nlet alertLevel = 'NORMAL';\nlet alertColor = '#00B894';\nlet alertTitle = 'Sinais Vitais Estáveis';\nlet alertDetails = 'Paciente em repouso dentro dos parâmetros clínicos adequados.';\nlet playSound = false;\n\n// Verificacao de Taquicardia Severa (> 120 BPM)\nif (bpm >= 120) {\n    alertLevel = 'CRÍTICO';\n    alertColor = '#D63031';\n    alertTitle = 'ALERTA: TAQUICARDIA SEVERA DETECTADA!';\n    alertDetails = `Frequência Cardíaca de ${bpm} BPM ultrapassou o limite seguro de 120 BPM. Risco de arritmia hemodinâmica.`;\n    playSound = true;\n} \n// Verificacao de Febre (> 38.0 C)\nelse if (temp >= 38.0) {\n    alertLevel = 'ALERTA';\n    alertColor = '#E67E22';\n    alertTitle = 'ALERTA: HIPERTERMIA / FEBRE ALTA';\n    alertDetails = `Temperatura corporal de ${temp.toFixed(1)} °C ultrapassou o limiar de 38.0 °C. Requer conduta antitérmica.`;\n    playSound = true;\n}\n// Verificacao de Bradicardia (< 60 BPM)\nelse if (bpm < 60 && bpm > 0) {\n    alertLevel = 'ATENÇÃO';\n    alertColor = '#F39C12';\n    alertTitle = 'ATENÇÃO: BRADICARDIA';\n    alertDetails = `Frequência Cardíaca em ${bpm} BPM abaixo do padrão basal esperado.`;\n}\n\nconst alertCard = {\n    level: alertLevel,\n    color: alertColor,\n    title: alertTitle,\n    details: alertDetails,\n    timestamp: new Date().toLocaleTimeString(),\n    bpm: bpm,\n    temp: temp\n};\n\nconst soundMsg = playSound ? { payload: 'alert_sound' } : null;\nreturn [{ payload: alertCard }, soundMsg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 440,
    "wires": [
      [
        "ui_alert_banner"
      ],
      [
        "ui_audio_alert"
      ]
    ]
  },
  {
    "id": "ui_alert_banner",
    "type": "ui_template",
    "z": "tab_cardioia",
    "group": "grp_alerts",
    "name": "Banner de Alertas",
    "order": 1,
    "width": "12",
    "height": "4",
    "format": "<div style=\"background-color: {{msg.payload.color || '#00B894'}}; color: white; padding: 16px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); font-family: sans-serif;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n    <h3 style=\"margin: 0; font-size: 18px; font-weight: bold;\">\n      <i class=\"fa fa-heartbeat\" style=\"margin-right: 8px;\"></i> {{msg.payload.title || 'Sistema Normal'}}\n    </h3>\n    <span style=\"background: rgba(255,255,255,0.25); padding: 4px 8px; border-radius: 4px; font-size: 12px;\">\n      Atualizado: {{msg.payload.timestamp || '--:--:--'}}\n    </span>\n  </div>\n  <p style=\"margin: 10px 0 0 0; font-size: 14px; opacity: 0.95;\">\n    {{msg.payload.details || 'Aguardando telemetria...'}}\n  </p>\n</div>",
    "storeOutMessages": true,
